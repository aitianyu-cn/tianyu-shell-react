{
    "include": [
        "packages/index.ts",
        "packages/src",
        "packages/resources.d.ts",
        "script",
        "*.d.ts",
        "__test__"
    ],
    "exclude": [],
    "compilerOptions": {
        "composite": true,
        "target": "ESNext",
        "module": "ESNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["dom", "dom.iterable", "esnext"],
        "jsx": "preserve",
        "allowJs": false,
        "allowSyntheticDefaultImports": true,
        "noFallthroughCasesInSwitch": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": false,
        "baseUrl": ".",
        "outDir": "./build",
        "paths": {
            "tianyu-shell-react": ["packages/index.ts"],
            "types/*": ["packages/src/types/*"],
            "components/*": ["packages/src/components/*"],
            "infra/*": ["packages/src/infra/*"],
            "model/*": ["packages/src/model/*"],
            "handler/*": ["packages/src/handler/*"],
            "script/*": ["script/*"]
        }
    }
}
